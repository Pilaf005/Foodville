# ==========================================
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. NEXT.JS BUILD & CACHE OUTPUTS
# ==========================================
/.next/
/out/
/build
/.turbo/
/.vercel
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 3. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ==========================================
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==========================================
# 4. DEBUG LOGS & TESTING
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage

# ==========================================
# 5. IDE, CODE EDITORS & AGENTS
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.agents/

# ==========================================
# 6. OPERATING SYSTEM ARTIFACTS
# ==========================================
.DS_Store
Thumbs.db
[Dd]esktop.ini

# ==========================================
# 7. TEMPORARY FILES, EXPORTS & AUDITS
# ==========================================
/scratch/
/tmp/
/temp/
*.xlsx
*.csv
export_products.js
foodville_security_audit.html
foodville_security_audit.pdf

# ==========================================
# 8. LOCAL GENERATED ASSETS & MAINTENANCE SCRIPTS
# ==========================================
/public/qr/
/src/scripts/
